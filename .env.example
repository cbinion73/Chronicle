# Chronicle Bible provider configuration.
# Chronicle now reads Bible content from the local library first.

# Preferred provider: offline | offline_asv | offline_kjv | offline_nkjv | offline_amp | offline_niv | local_<translation>
VITE_BIBLE_PROVIDER=offline_nkjv

# Shared secret protecting every /api endpoint. REQUIRED for any deployment that is
# reachable beyond your own machine (LAN serving, Docker/VPS). When set, the browser
# prompts for this value once and stores it locally. Generate with: openssl rand -hex 32
# CHRONICLE_API_TOKEN=
