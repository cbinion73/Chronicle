generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CHRONICLE_DATABASE_URL")
}

// ── Chronicle Journal Entries ─────────────────────────────────────────────────

model ChronicleEntry {
  id            String   @id
  date          String
  type          String   // 'insight' | 'prayer' | 'study' | 'note' | 'reflection' | 'growth' | 'rule' | 'sealed' | 'question' | 'heritage'
  title         String
  body          String
  passage       String?
  themes        String[]
  autoCapture   Boolean  @default(false)
  sourceContext Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("chronicle_entries")
}

// ── Prayer Items ──────────────────────────────────────────────────────────────

model PrayerItem {
  id             String   @id
  text           String
  category       String   // 'people' | 'needs' | 'praise' | 'world'
  answered       Boolean  @default(false)
  dateAdded      String
  dateAnswered   String?
  answerSummary  String?
  answerPassage  String?
  lastPrayedAt   String?
  timesPrayed    Int      @default(0)
  nextFollowUpAt String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("prayer_items")
}

// ── Formation Rhythms ─────────────────────────────────────────────────────────

model FormationRhythm {
  id             String   @id
  title          String
  cadence        String   // 'daily' | 'weekly'
  focus          String
  prompt         String
  relatedPassage String?
  completions    String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("formation_rhythms")
}

// ── Scripture Bookmarks ───────────────────────────────────────────────────────

model ScriptureBookmark {
  id         String   @id
  label      String
  passage    String
  book       String
  chapter    Int
  verseStart Int?
  verseEnd   Int?
  createdAt  String
  insertedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("scripture_bookmarks")
}

// ── Owned Books ───────────────────────────────────────────────────────────────

model OwnedBook {
  id             String   @id
  schemaVersion  Int      @default(2)
  title          String
  author         String?
  recordId       String?
  sourcePath     String
  textPath       String?
  classification String
  workflow       String
  status         String
  summary        String
  importedAt     String
  generatedPlan  Json?
  studyState     Json?
  assets         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("owned_books")
}

// ── Library Catalog ───────────────────────────────────────────────────────────

model LibraryCatalogEntry {
  id        String   @id
  record    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("library_catalog_entries")
}

// ── The Thread ─────────────────────────────────────────────────────────────
// A durable, queryable projection over chronicle_entries + prayer_items —
// Milestone 2 of the product rebuild. Kept in sync server-side whenever an
// entry or prayer is created/updated/deleted (see server/chronicleApi.ts),
// so it never depends on any one client having run. The client-side
// derivation in src/lib/thread.ts remains the offline-first source of truth
// for what the UI renders instantly; this table is what makes the Thread
// physical and queryable across devices and future services (e.g. the
// Scripture Memory Engine, the Question Lab).
model ThreadEvent {
  id        String   @id
  date      String
  kind      String   // 'entry' | 'prayer-added' | 'prayer-answered'
  entryType String?  // set when kind === 'entry'
  title     String
  body      String?
  passage   String?
  sourceId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
  @@index([date])
  @@map("thread_events")
}

// ── Scripture Memory Engine ────────────────────────────────────────────────
// Verses a user is memorizing, scheduled with a lightweight spaced-repetition
// algorithm (SM-2-family). This is the highest formation-value-per-
// engineering-hour item in the whole rebuild vision — no AI required.
model MemoryVerse {
  id            String    @id
  reference     String
  text          String
  translation   String    @default("NKJV")
  // SM-2 scheduling state
  easeFactor    Float     @default(2.5)
  intervalDays  Int       @default(0)
  repetitions   Int       @default(0)
  dueDate       String
  lastReviewedAt String?
  // lifetime stats
  totalReviews  Int       @default(0)
  totalLapses   Int       @default(0)
  addedAt       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([dueDate])
  @@map("memory_verses")
}

// ── App Settings (singleton) ──────────────────────────────────────────────────

model AppSettings {
  id                  String   @id @default("singleton")
  experienceMode      String   @default("fresh")
  theme               String   @default("light")
  translation         String   @default("NKJV")
  bibleView           Json     @default("{}")
  streakDays          Int      @default(0)
  currentPlanName     String   @default("Daily Walk")
  currentPlanDay      Int      @default(1)
  currentPlanTotal    Int      @default(365)
  activeStudyModuleId String   @default("bible-study")
  studyModuleDayById  Json     @default("{}")
  activeOwnedBookId   String   @default("")
  syncProfile         Json?
  voiceConfig         Json?
  toggles             Json     @default("{}")
  profile             Json     @default("{}")
  updatedAt           DateTime @updatedAt

  @@map("app_settings")
}
